# Copy to .env.local and fill in real values (never commit .env.local).

# LLM provider (OpenAI-compatible). For DeepSeek:
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Fallback OpenAI key (still used for embeddings + transcription):
OPENAI_API_KEY=

# Web search
TAVILY_API_KEY=

# Spotify (optional — real Spotify episode links for the feed; free client-credentials app; without it podcasts fall back to iTunes)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DB_PASSWORD=

# NextAuth / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Web push notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Alexa skill endpoint (your deployed app URL)
ALEXA_ENDPOINT=

# Coding agent (worker that edits files — run `npm run agent` where the repo is)
CODING_AGENT_URL=http://127.0.0.1:8787
CODING_AGENT_TOKEN=

# Android KWGT widget (read-only todos endpoint; generate with: openssl rand -hex 16)
WIDGET_TOKEN=
