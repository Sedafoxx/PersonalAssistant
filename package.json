{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "suggestions": "node --env-file=.env.local scripts/suggestions.mjs",
    "ask:prepare": "node --env-file=.env.local scripts/prepare-skill.mjs",
    "ask:smoke": "node --env-file=.env.local --import tsx scripts/alexa-smoke.ts",
    "ask:features": "node --env-file=.env.local --import tsx scripts/feature-test.ts",
    "agent": "node --env-file=.env.local scripts/coding-agent-server.mjs",
    "agent:test": "node --env-file=.env.local --import tsx scripts/agent-test.ts",
    "ask:deploy": "npm run ask:prepare && ask deploy",
    "coach:test": "node --env-file=.env.local --import tsx scripts/coach-test.ts",
    "feed:test": "node --env-file=.env.local --import tsx scripts/feed-test.ts",
    "feed:rank": "node --env-file=.env.local --import tsx scripts/feed-rank-test.ts",
    "memory:test": "node --env-file=.env.local --import tsx scripts/memory-test.ts",
    "review:test": "node --env-file=.env.local --import tsx scripts/review-test.ts",
    "brief:test": "node --env-file=.env.local --import tsx scripts/brief-test.ts",
    "backlog:test": "node --env-file=.env.local --import tsx scripts/backlog-test.ts",
    "todos:test": "node --env-file=.env.local --import tsx scripts/todo-lifecycle-test.ts",
    "memory:backfill": "node --env-file=.env.local --import tsx scripts/memory-backfill.ts",
    "memory:retrieval:test": "node --env-file=.env.local --import tsx scripts/memory-retrieval-test.ts",
    "memory:consolidate": "node --env-file=.env.local --import tsx scripts/memory-consolidate.ts",
    "memory:oneshop:test": "node --env-file=.env.local --import tsx scripts/memory-oneshop-test.ts",
    "feed:page:test": "node --env-file=.env.local --import tsx scripts/feed-page-test.ts",
    "feed:describe": "node --env-file=.env.local --import tsx scripts/feed-descriptions-backfill.ts",
    "search:test": "node --env-file=.env.local --import tsx scripts/search-rank-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "googleapis": "^173.0.0",
    "next": "^15.3.3",
    "next-auth": "^4.24.14",
    "openai": "^4.98.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "ask-cli": "^2.30.0",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
